# Postgres superuser created the first time the db volume is initialized
POSTGRES_USER=budgeter
# Password for POSTGRES_USER; replace it, and use only letters, digits, - and _ so the URLs stay valid
POSTGRES_PASSWORD=change-me
# Database created the first time the db volume is initialized
POSTGRES_DB=budgeter
# Host port for Postgres, published on 127.0.0.1 only
POSTGRES_PORT=5432
# Host port for the API, published on 127.0.0.1 only
API_PORT=8000
# Host-side URL for tests and local tools; must match the POSTGRES_* values above
DATABASE_URL=postgresql://budgeter:change-me@localhost:5432/budgeter
